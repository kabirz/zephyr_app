# Gateway application configuration

mainmenu "gateway"

source "Kconfig.zephyr"

config GATEWAY_RF24_RX_STACK
	int "RF24 RX thread stack size"
	default 1024

config GATEWAY_RF24_RX_PRIORITY
	int "RF24 RX thread priority"
	default 8

config GATEWAY_DATA_RX_STACK
	int "UDP data RX thread stack size"
	default 1024

config GATEWAY_DATA_RX_PRIORITY
	int "UDP data RX thread priority"
	default 10

config GATEWAY_UDP_INIT_PRIORITY
	int "UDP app handler init priority (must run before udp_fw_upgrade lib)"
	default 80

config GATEWAY_LED_STACK
	int "LED status thread stack size"
	default 512

config GATEWAY_LED_PRIORITY
	int "LED status thread priority (lowest, do not preempt business threads)"
	default 14
